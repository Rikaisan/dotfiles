#!/usr/bin/env python3

import sys
import string

def nameify(name) -> str:
    name = name.strip().lower()
    punctuation = string.punctuation + "“”「」『』"

    for ch in punctuation:
        name = name.replace(ch, "")

    for ch in string.whitespace:
        name = name.replace(ch, "_")

    return name

if __name__ == "__main__":
    if len(sys.argv) > 1:
        parsed_name=""

        for piece in sys.argv[1:]:
            parsed_name += f"{piece} "

        print(nameify(parsed_name))
    else:
        try:
            print(nameify(input()))
        except EOFError:
            pass
